    "import cv2\n",
    "import numpy as np \n",
    "import matplotlib.pyplot as plt \n",
    "\n",
    "img = cv2.imread('duck.jpg', cv2.IMREAD_GRAYSCALE)\n",
    "equ = cv2.equalizeHist(img)\n",
    "res  =np.hstack((img, equ))\n",
    "cv2.imwrite('res.png',res)"
   ]
